# ==========================================
# MyLike + Media-Parser 统一环境变量配置
# 复制本文件为 .env 并根据实际需求填入配置
# ==========================================

# --- 镜像源配置 (构建时生效) ---
# 可选值:
#   国内公网:  mirrors.aliyun.com / mirrors.aliyun.com/pypi/simple (留空时的默认值)
#   海外官方:  deb.debian.org / pypi.org/simple
#   清华备选:  mirrors.tuna.tsinghua.edu.cn / pypi.tuna.tsinghua.edu.cn/simple
APT_MIRROR=mirrors.aliyun.com
PIP_MIRROR=mirrors.aliyun.com/pypi/simple

# --- MyLike 配置 ---
# MyLike 调用 media-parser 的认证密钥 (mp- 前缀 + 24 位随机字符)
# 获取方式: 访问 http://localhost:8051 → 创建管理员 → 控制台生成 API Key → 填入此处
MEDIA_PARSER_API_KEY=

# --- media-parser 基础配置 ---
# Flask 会话加密密钥，留空则自动生成 64 位随机 hex 并持久化到 data/.secret_key
SECRET_KEY=
# 是否信任反向代理 (Nginx/Caddy) 传递的 X-Forwarded-* 请求头
# false = 直接暴露端口访问 (默认)
# true  = 通过反向代理访问，启用 ProxyFix 中间件
TRUST_PROXY_HEADERS=false

# --- 平台 Cookie (可选，不配置也可开箱即用) ---

# 小红书 Cookie — 部分需要登录才能查看的笔记
XHS_COOKIE=

# 抖音 Cookie — 常规免配；实况图需完整登录 Cookie + UIFID；放映厅长片需 s_v_web_id
DOUYIN_COOKIE=

# 豆包 Cookie — 提取豆包 AI 深度会话中的多媒体内容
DOUBAO_COOKIE=

# 腾讯元宝 / 微信视频号 Cookie — 视频号解析依赖元宝接口，需含 user_id 和 session
YUANBAO_COOKIE=

# 拼多多 Cookie — 拼多多短视频 dsp_detail 接口鉴权
PINDUODUO_COOKIE=

# 快手 Cookie — 应对高频反爬拦截 (result: 2 / ANTICRAWL_DEFAULT)
KUAISHOU_COOKIE=

# 即梦 AI Cookie — 即梦作品页鉴权
JIMENG_COOKIE=

# 微博 Cookie — 微博长图文与特定视频流提取
WEIBO_COOKIE=